Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never serve dotfiles (.git, .env, ...); keep /.well-known reachable
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # Server-side includes are not public
  RewriteRule ^inc(/|$) - [F,L]

  # Drop www on janrobas.com
  RewriteCond %{HTTP_HOST} ^www\.janrobas\.com$ [NC]
  RewriteRule ^ https://janrobas.com%{REQUEST_URI} [R=301,L]

  # Force https on janrobas.com
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-SSL} !on
  RewriteCond %{HTTP_HOST} ^janrobas\.com$ [NC]
  RewriteRule ^ https://janrobas.com%{REQUEST_URI} [R=301,L]

  # Drop www + force https on lalala.si (stays on its own domain; canonical consolidates to janrobas.com)
  RewriteCond %{HTTP_HOST} ^www\.lalala\.si$ [NC]
  RewriteRule ^ https://lalala.si%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-SSL} !on
  RewriteCond %{HTTP_HOST} ^lalala\.si$ [NC]
  RewriteRule ^ https://lalala.si%{REQUEST_URI} [R=301,L]

  # *.html -> index.php?subpage=X (only when no real file exists)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^([^/.]+)\.html$ index.php?subpage=$1 [L,QSA]

  # Anything else that is not a real file/dir -> styled 404 (index.php sets the status)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php?subpage=notfound [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header unset X-Powered-By
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  # Monitor-only: check the browser console for violations, then drop -Report-Only
  # (inline scripts in index.php/contact.php would need a nonce before enforcing)
  Header set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://js.hcaptcha.com; style-src 'self'; font-src 'self'; img-src 'self' https://img.itch.zone; frame-src https://hcaptcha.com https://*.hcaptcha.com; connect-src 'self' https://*.hcaptcha.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'"

  <FilesMatch "\.(css|js|png|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
</IfModule>
