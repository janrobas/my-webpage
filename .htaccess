Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never serve dotfiles (.git, .env, ...); keep /.well-known reachable
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # Force https://janrobas.com (all paths, drop www)
  RewriteCond %{HTTP_HOST} ^www\.janrobas\.com$ [NC]
  RewriteRule ^ https://janrobas.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-SSL} !on
  RewriteCond %{HTTP_HOST} ^janrobas\.com$ [NC]
  RewriteRule ^ https://janrobas.com%{REQUEST_URI} [R=301,L]

  # *.html -> index.php?subpage=X (only when no real file exists)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^([^/.]+)\.html$ index.php?subpage=$1 [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header unset X-Powered-By
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  <FilesMatch "\.(css|js|png|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
</IfModule>
